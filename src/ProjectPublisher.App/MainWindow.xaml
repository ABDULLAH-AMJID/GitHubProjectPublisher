<Window x:Class="ProjectPublisher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEON GIT // Project Publisher" Width="1380" Height="920" MinWidth="1140" MinHeight="740"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0E1528" BorderBrush="#202C48" BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="NG" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,0,0">
                    <TextBlock Text="NEON GIT // PROJECT PUBLISHER" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Native command-driven GitHub automation" Foreground="{StaticResource Accent2Brush}" FontSize="12"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource Surface2Brush}" CornerRadius="18" Padding="13,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#F1A94E" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ConnectionText" Text="GitHub not connected" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="1  GitHub connection" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="OAuth Device Flow; no password or client secret is stored." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,16" TextWrapping="Wrap"/>
                            <Label Content="OAuth App Client ID"/>
                            <TextBox x:Name="ClientIdBox" ToolTip="Create an OAuth App in GitHub Developer Settings and enable Device Flow."/>
                            <TextBlock Text="Client ID is public configuration. OAuth tokens go only to Windows Credential Manager."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,12" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ConnectButton" Content="Connect GitHub" Style="{StaticResource PrimaryButton}" Click="Connect_Click"/>
                                <Button x:Name="DisconnectButton" Content="Sign out" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Disconnect_Click" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="2  Select project workspace" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="DIRECT MODE // Git metadata and commits are created in this folder. Protected source files remain local." Foreground="{StaticResource Accent2Brush}" Margin="0,5,0,14" TextWrapping="Wrap"/>
                            <Label Content="Project folder"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderBox" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Browse_Click"/>
                            </Grid>
                            <Button x:Name="AnalyzeButton" Content="Scan workspace + detect Git" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="Analyze_Click"/>
                            <UniformGrid Columns="4" Margin="0,10,0,0">
                                <Button x:Name="GitStatusButton" Content="Status" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Padding="8,8" Click="GitStatus_Click"/>
                                <Button x:Name="FetchButton" Content="Fetch" Style="{StaticResource SecondaryButton}" Margin="2,0,3,0" Padding="8,8" Click="Fetch_Click"/>
                                <Button x:Name="PullButton" Content="Pull" Style="{StaticResource SecondaryButton}" Margin="3,0,2,0" Padding="8,8" Click="Pull_Click"/>
                                <Button x:Name="HistoryButton" Content="History" Style="{StaticResource SecondaryButton}" Margin="5,0,0,0" Padding="8,8" Click="History_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="3  Repository details" FontSize="17" FontWeight="SemiBold"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="Owner"/>
                                    <TextBox x:Name="OwnerBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Repository name"/>
                                    <TextBox x:Name="RepoNameBox"/>
                                </StackPanel>
                            </Grid>
                            <Label Content="Description" Margin="0,12,0,0"/>
                            <TextBox x:Name="DescriptionBox" MaxLength="350"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="Branch"/>
                                    <TextBox x:Name="BranchNameBox" Text="main"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Commit message"/>
                                    <TextBox x:Name="CommitMessageBox" Text="Publish project update" MaxLength="180"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="PrivateRepoCheck" Content="Private repository (new repositories only)" Margin="0,12,0,0"/>
                            <CheckBox x:Name="GenerateReadmeCheck" Content="Generate README in the project if one is missing" IsChecked="True"/>
                            <CheckBox x:Name="ReplaceOriginCheck" Content="Replace origin when it points to a different repository"/>
                            <TextBlock Text="Force-push is disabled. A different origin requires this explicit approval."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="4  Interface screenshot" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Captures the actual project UI—not an AI-generated image." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,13"/>
                            <Label Content="Start command (web; auto-detected)"/>
                            <TextBox x:Name="ScreenshotCommandBox"/>
                            <Label Content="Local preview URL" Margin="0,10,0,0"/>
                            <TextBox x:Name="PreviewUrlBox"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="CaptureButton" Content="Auto capture" Style="{StaticResource PrimaryButton}" Click="Capture_Click"/>
                                <Button x:Name="SelectImageButton" Content="Select image" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="SelectImage_Click"/>
                                <Button x:Name="ClearImageButton" Content="Clear" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="ClearImage_Click"/>
                            </StackPanel>
                            <Border x:Name="PreviewBorder" Height="170" Background="#0E1528" CornerRadius="9" Margin="0,14,0,0" BorderBrush="#2A3655" BorderThickness="1">
                                <Grid>
                                    <TextBlock x:Name="PreviewPlaceholder" Text="No screenshot selected" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="5"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Button x:Name="PublishButton" Content="EXECUTE SECURE GIT PIPELINE" Style="{StaticResource PrimaryButton}" FontSize="16" Padding="18,14" Click="Publish_Click" IsEnabled="False"/>
                    <CheckBox x:Name="OpenAfterPublishCheck" Content="Open repository after publishing" IsChecked="True" Margin="4,9,0,20"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Project analysis" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AnalysisSubtitle" Text="Choose a folder and run analysis to see project details." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12"/>
                            <Border Background="#0E1528" BorderBrush="#2A3655" BorderThickness="1" CornerRadius="9" Padding="13,9" Margin="0,0,0,14">
                                <TextBlock Text="SCAN  ›  PROTECT  ›  STAGE  ›  COMMIT  ›  LINK  ›  PUSH" Foreground="{StaticResource Accent2Brush}" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Border>
                            <UniformGrid Columns="4">
                                <Border Background="#0E1528" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                    <StackPanel><TextBlock Text="TYPE" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="TypeStat" Text="—" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                </Border>
                                <Border Background="#0E1528" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                    <StackPanel><TextBlock Text="FILES" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="FilesStat" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                                </Border>
                                <Border Background="#0E1528" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                    <StackPanel><TextBlock Text="SOURCE SIZE" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="SizeStat" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                                </Border>
                                <Border Background="#0E1528" CornerRadius="10" Padding="14">
                                    <StackPanel><TextBlock Text="LOCAL-ONLY FILES" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="FindingsStat" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock x:Name="TechnologyText" Text="" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Security report" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Secret values are never shown. Critical/warning files remain local and are removed from the Git index." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" x:Name="FindingsGrid" Height="310" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#0E1528" Foreground="{StaticResource TextBrush}" BorderBrush="#273450"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#202C48" HeadersVisibility="Column"
                                      RowBackground="#0E1528" AlternatingRowBackground="#111A2E" CanUserAddRows="False">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#18223A"/><Setter Property="Foreground" Value="#CAD2E8"/>
                                        <Setter Property="Padding" Value="9"/><Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,6"/></Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85"/>
                                    <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="*"/>
                                    <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="55"/>
                                    <DataGridTextColumn Header="Detected" Binding="{Binding Kind}" Width="145"/>
                                    <DataGridTextColumn Header="Safe action" Binding="{Binding Action}" Width="210"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Accent2Brush}" Margin="0,0,9,0"/>
                                <TextBlock Text="LIVE GIT TERMINAL" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBox x:Name="ActivityLog" Height="190" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0E1528" BorderBrush="#202C48" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" x:Name="BusyBar" Width="160" Height="5" Margin="12,0" IsIndeterminate="False" VerticalAlignment="Center" Foreground="{StaticResource Accent2Brush}"/>
                <Button Grid.Column="2" x:Name="CancelButton" Content="Cancel operation" Style="{StaticResource SecondaryButton}" Padding="11,6" IsEnabled="False" Click="Cancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
